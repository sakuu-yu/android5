<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHeader"
            style="@style/AppHeader"
            android:text="@string/app_name" />

        <FrameLayout
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp">

            <FrameLayout
                android:id="@+id/avatarPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <cn.edu.sicnu.cs.why.myapplication.CrossBoxView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:borderWidth="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="#FFFFFF"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/avatar"
                    android:textColor="#212121"
                    android:textSize="14sp" />
            </FrameLayout>

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF"
                android:contentDescription="@string/content_desc_avatar"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/InfoLabel"
                    android:text="@string/label_name" />

                <TextView
                    android:id="@+id/tvName"
                    style="@style/InfoValue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/InfoLabel"
                    android:text="@string/label_gender" />

                <TextView
                    android:id="@+id/tvGender"
                    style="@style/InfoValue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/InfoLabel"
                    android:text="@string/label_student_id" />

                <TextView
                    android:id="@+id/tvStudentId"
                    style="@style/InfoValue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/InfoLabel"
                    android:text="@string/label_phone" />

                <TextView
                    android:id="@+id/tvPhone"
                    style="@style/InfoValue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/InfoLabel"
                    android:text="@string/label_email" />

                <TextView
                    android:id="@+id/tvEmail"
                    style="@style/InfoValue"
                    android:autoLink="email" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/InfoLabel"
                    android:text="@string/label_hobbies" />

                <TextView
                    android:id="@+id/tvHobbies"
                    style="@style/InfoValue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/InfoLabel"
                    android:text="@string/label_best_score" />

                <TextView
                    android:id="@+id/tvBestScore"
                    style="@style/InfoValue" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/btnEditProfile"
                style="@style/PinkButton"
                android:text="@string/btn_edit_profile" />

            <TextView
                android:id="@+id/btnPlayGame"
                style="@style/PinkButton"
                android:layout_marginStart="12dp"
                android:text="@string/btn_play_game" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
