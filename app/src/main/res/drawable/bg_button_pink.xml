<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#C08A8E" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:right="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#F3C7CA" />
            <stroke
                android:width="2dp"
                android:color="#A65353" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
